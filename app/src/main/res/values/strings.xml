    <string name="highpass_hint">Entfernt Wind, Verkehr und Gebäudevibration. Die tiefste heimische Vogelstimme (Uhu) liegt bei etwa 250 Hz.</string>
    <string name="gain_label">Verstärkung (1.0 = unverändert)</string>
