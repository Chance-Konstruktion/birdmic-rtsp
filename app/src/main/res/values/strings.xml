    <string name="channels_label">Channels</string>
    <string name="highpass_label">High-pass filter</string>
    <string name="highpass_hint">Removes wind, traffic, and building vibration. The lowest call of a native bird (Eurasian eagle-owl) is about 250 Hz.</string>
    <string name="gain_label">Gain (1.0 = unchanged)</string>
    <string name="port_label">Port</string>
    <string name="path_label">Path</string>
    <string name="mdns_label">Advertise a name on the network (mDNS)</string>
    <string name="mdns_hint">Makes the stream discoverable on the network. On the Pi, use “avahi-browse -rt _rtsp._tcp” to display it — this returns the current IP even if it changes. Whether a name such as birdmic.local also resolves is decided by the phone; do not rely on it, assign a fixed IP in the router instead.</string>
    <string name="web_label">Web interface in browser (read-only)</string>
    <string name="web_port_label">Web interface port</string>
    <string name="web_hint">Shows status, log, and spectrogram in the browser without having to pick up the phone. The server cannot change or start anything — it only reads. Without access protection, anyone on the same Wi-Fi can see it, so it is disabled by default.</string>
    <string name="bad_web_port_same">Web server and RTSP cannot use the same port</string>
    <string name="detail_web">\nWeb interface: %1$s</string>

    <string name="update_label">Check for a new version when opening</string>
    <string name="update_hint">Queries only the project GitLab, at most every six hours, and only while the app is open. Nothing is downloaded or installed automatically — an installation would stop the running stream.</string>
    <string name="update_available">Version %1$s is available (you have %2$s)</string>
    <string name="update_download">Download</string>
    <string name="update_warning">Installing replaces the app and stops the running stream.</string>

    <string name="udp_timeout_label">UDP timeout in seconds (0 = off)</string>
    <string name="max_clients_label">Maximum recipients in total (0 = unlimited)</string>
    <string name="max_per_ip_label">Maximum recipients per address (0 = unlimited)</string>
    <string name="max_clients_hint">Protects against recipients multiplying after a connection error. Each recipient uses the full bandwidth — 13 at once are about 10 Mbit/s. If exceeded, the oldest is disconnected; the new one is not rejected.</string>
    <string name="bad_limit">Value must be between 0 and 32</string>
    <string name="auth_hint">Leave both fields empty = no protection. Digest authentication transmits only a hash, but the audio remains unencrypted.</string>
    <string name="auth_user_hint">Username (optional)</string>
    <string name="auth_password_hint">Password (optional)</string>
    <string name="amoled_label">Always dark (AMOLED black)</string>
    <string name="amoled_hint">Does not save power during continuous operation — the display is off then anyway. Helps with reading at dusk and against burn-in if the display remains on permanently.</string>
    <string name="autostart">Start automatically after restart</string>
    <string name="battery_warn_label">Warn from battery temperature in °C (0 = off)</string>

